rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /students/{userId} {
      allow read: if isOwner(userId) || isAdmin() || resource.data.isPublic == true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /student_progress/{userId} {
      allow read: if isOwner(userId) || isAdmin()
        || get(/databases/$(database)/documents/students/$(userId)).data.isPublic == true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /math_arena/{arenaId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /duel-questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false;
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isOwner(teacherId) || isAdmin();
    }

    match /homework/{homeworkId} {
      allow read: if true;
      allow create, update: if isOwner(request.resource.data.teacherId) || isAdmin();
      allow delete: if isOwner(resource.data.teacherId) || isAdmin();
    }

    match /warm_words/{noteId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /homework_submissions/{submissionId} {
      allow read: if isAdmin()
        || isOwner(resource.data.studentUid)
        || isOwner(get(/databases/$(database)/documents/homework/$(resource.data.homeworkId)).data.teacherId);
      allow create: if isOwner(request.resource.data.studentUid);
      allow update: if isOwner(resource.data.studentUid)
        || isOwner(get(/databases/$(database)/documents/homework/$(resource.data.homeworkId)).data.teacherId)
        || isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
